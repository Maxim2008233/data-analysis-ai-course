{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site-dev",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-lc", "export PATH=/opt/homebrew/opt/node@24/bin:$PATH && npm run dev -- --port 3000"],
      "port": 3000
    },
    {
      "name": "site-prod",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-lc", "export PATH=/opt/homebrew/opt/node@24/bin:$PATH && npm run start -- --port 3100"],
      "port": 3100
    }
  ]
}
