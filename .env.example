# Скопируйте в .env.local (локально) и задайте в Vercel → Settings → Environment Variables.

# --- Публичные (попадают в браузер; это нормально, доступ защищён RLS) ---
# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase → Project Settings → API → anon public key (или Publishable key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Ссылка «Нашли ошибку?» (необязательно; по умолчанию — Issues репозитория на GitHub, см. src/lib/config.ts)
NEXT_PUBLIC_REPORT_BUG_URL=https://github.com/Maxim2008233/data-analysis-ai-course/issues/new

# --- Секретные (только на сервере, НИКОГДА не с префиксом NEXT_PUBLIC_) ---
# Необязательно: таблица лидеров соревнований (запись результатов делает сервер)
SUPABASE_SERVICE_ROLE_KEY=
# Ключ GigaChat сайту не нужен: модуль 10 работает на учебной версии, свои запросы ученики отправляют из Colab.
